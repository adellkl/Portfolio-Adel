rules_version = '2';

// Portfolio Adel Loukal — règles Storage
// Images des projets : lecture publique, envoi et suppression réservés à l'admin (images de 10 Mo max).
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    match /projets/{slug}/{file} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
    match /{all=**} {
      allow read, write: if false;
    }
  }
}
